# VectoraFix Environment Configuration Template
# NOTE: All secrets are managed via environment variables or secret vaults.

VECTORAFIX_ENV=production
VECTORAFIX_API_BASE_URL=https://api.vectorafix.internal/api
VECTORAFIX_FRONTEND_ORIGIN=https://console.vectorafix.internal

# Database Persistence
MONGODB_URI=mongodb://mongodb-cluster:27017
MONGODB_DATABASE=VectoraFix

# Cryptographic Keys & Authentication
VECTORAFIX_JWT_SECRET=generate-a-cryptographically-secure-random-256-bit-key
VECTORAFIX_OAUTH_TOKEN_KEY=generate-a-cryptographically-secure-aes-gcm-key

# GitHub App / OAuth Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://api.vectorafix.internal/api/auth/callback/github

# Google Gemini Multi-Agent Model Configuration
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-pro
GEMINI_REQUEST_TIMEOUT_SECONDS=180

# Isolated Docker Sandbox Constraints
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_EXECUTION_TIMEOUT_SECONDS=180
